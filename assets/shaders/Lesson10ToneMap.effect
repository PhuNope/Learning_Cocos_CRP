CCEffect %{
  techniques:
  - passes:
    # 0: lesson10-tonemap-opaque
    - vert: lesson10-vs
      frag: lesson10-tonemap-opaque-fs
      pass: lesson10-tonemap-opaque
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: false
        depthWrite: false
    # 1: lesson10-tonemap-alpha
    - vert: lesson10-vs
      frag: lesson10-tonemap-alpha-fs
      pass: lesson10-tonemap-alpha
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram lesson10-vs %{
  precision highp float;
  #include <legacy/decode-standard>
  #include <builtin/uniforms/cc-global>
  #include <common/common-define>
  out vec2 v_uv;
  void main () {
    StandardVertInput In;
    CCDecode(In);
    CC_HANDLE_GET_CLIP_FLIP(In.position.xy);
    gl_Position = In.position;
    v_uv = a_texCoord;
  }
}%


CCProgram lesson10-tonemap-opaque-fs %{
  precision highp float;
  in vec2 v_uv;
  #pragma rate inputTexture pass
  uniform sampler2D inputTexture; // combined or radiance
  #pragma rate sceneTexture pass
  uniform sampler2D sceneTexture; // original radiance, without bloom
  #pragma rate L10ToneParams pass
  uniform L10ToneParams { vec4 toneParams; };
  layout(location = 0) out vec4 fragColor;

  vec3 toneMap(vec3 c, float exposure, float kind) {
    vec3 x = max(c * exposure, vec3(0.0));
    if (kind < 0.5) return x / (vec3(1.0) + x); // Reinhard
    // ACES filmic approximation (not the official Academy RRT+ODT)
    return clamp((x * (2.51 * x + vec3(0.03))) /
                 (x * (2.43 * x + vec3(0.59)) + vec3(0.14)), 0.0, 1.0);
  }
  vec3 toSRGB(vec3 c) {
    vec3 x = max(c, vec3(0.0));
    vec3 lo = 12.92 * x;
    vec3 hi = 1.055 * pow(x, vec3(1.0 / 2.4)) - vec3(0.055);
    return mix(lo, hi, step(vec3(0.0031308), x));
  }

  void main () {
    vec4 total = texture(inputTexture, v_uv);
    vec4 base = texture(sceneTexture, v_uv);
    vec3 mappedAll = toneMap(total.rgb, toneParams.x, toneParams.y);
    vec3 mappedBase = toneMap(base.rgb, toneParams.x, toneParams.y);
    if (toneParams.z > 0.5) {
      mappedAll = toSRGB(mappedAll);
      mappedBase = toSRGB(mappedBase);
    }
    fragColor = vec4(mappedAll, 1.0);
  }
}%


CCProgram lesson10-tonemap-alpha-fs %{
  precision highp float;
  in vec2 v_uv;
  #pragma rate inputTexture pass
  uniform sampler2D inputTexture; // combined or radiance
  #pragma rate sceneTexture pass
  uniform sampler2D sceneTexture; // original radiance, without bloom
  #pragma rate L10ToneParams pass
  uniform L10ToneParams { vec4 toneParams; };
  layout(location = 0) out vec4 fragColor;

  vec3 toneMap(vec3 c, float exposure, float kind) {
    vec3 x = max(c * exposure, vec3(0.0));
    if (kind < 0.5) return x / (vec3(1.0) + x); // Reinhard
    // ACES filmic approximation (not the official Academy RRT+ODT)
    return clamp((x * (2.51 * x + vec3(0.03))) /
                 (x * (2.43 * x + vec3(0.59)) + vec3(0.14)), 0.0, 1.0);
  }
  vec3 toSRGB(vec3 c) {
    vec3 x = max(c, vec3(0.0));
    vec3 lo = 12.92 * x;
    vec3 hi = 1.055 * pow(x, vec3(1.0 / 2.4)) - vec3(0.055);
    return mix(lo, hi, step(vec3(0.0031308), x));
  }

  void main () {
    vec4 total = texture(inputTexture, v_uv);
    vec4 base = texture(sceneTexture, v_uv);
    vec3 mappedAll = toneMap(total.rgb, toneParams.x, toneParams.y);
    vec3 mappedBase = toneMap(base.rgb, toneParams.x, toneParams.y);
    if (toneParams.z > 0.5) {
      mappedAll = toSRGB(mappedAll);
      mappedBase = toSRGB(mappedBase);
    }
    // Glow được ADD riêng, không nhân bloom thêm lần nữa với alpha yếu.
    vec3 glow = max(mappedAll - mappedBase, vec3(0.0));
    float glowLum = dot(glow, vec3(0.2126, 0.7152, 0.0722));
    float alpha = max(base.a, clamp(glowLum * toneParams.w, 0.0, 1.0));
    vec3 preMul = mappedBase * base.a + glow;
    fragColor = vec4(clamp(preMul, 0.0, 1.0), alpha);
  }
}%
